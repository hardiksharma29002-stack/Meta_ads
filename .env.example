# ==============================================================================
# AdAtlas India - Environment Configuration (Free Tier & Local Development)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
APP_NAME=AdAtlas
FRONTEND_URL=http://localhost:3000

# Authentication (Free Tier / Local Dev: 'mock' requires no Google OAuth credentials)
AUTH_MODE=mock
JWT_SECRET_PRIMARY=change_this_to_a_secure_256_bit_secret_in_production_1234567890
JWT_SECRET_SECONDARY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database Configuration (PostgreSQL 16)
# For local Docker: postgresql+asyncpg://adatlas:adatlas_dev_password@localhost:5432/adatlas_dev
# For zero-infra standalone test: sqlite+aiosqlite:///./test.db
DATABASE_URL=postgresql+asyncpg://adatlas:adatlas_dev_password@localhost:5432/adatlas_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage Tier (Free Tier: 'local' uses local disk folder; 's3' uses MinIO / AWS S3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=adatlas-raw-payloads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=ap-south-1

# Data Collector Adapters (Free Tier / Test Fixture Mode Enabled by Default)
# Adapter A: Official Meta Graph API (Optional - uses mock fixtures if empty)
ADAPTER_A_ENABLED=true
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Adapter B: Managed Commercial Provider (Optional - uses built-in fixtures / free scraper if empty)
ADAPTER_B_ENABLED=true
ADAPTER_B_PROVIDER=apify_free_tier
ADAPTER_B_API_KEY=

# Adapter C: Playwright Headless Scraper (Strictly OFF per ADR-0001, ADR-0002)
ADAPTER_C_ENABLED=false

# Optional External API Services (Free Tier: empty means mock/rules mode is used)
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=

# Monthly Billable Spend Ceilings (USD)
BUDGET_CAP_PROVIDER=150.00
BUDGET_CAP_PLACES=100.00
BUDGET_CAP_LLM=50.00

# Operational Controls
COLLECTION_ENABLED=true
MAX_PAGES_PER_DOMAIN=8
REQUEST_TIMEOUT_SECONDS=10
MAX_DECOMPRESSED_BODY_BYTES=2097152

